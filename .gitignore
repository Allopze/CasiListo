privacy-site/dist/
artifacts/
build/

# Ruido de macOS
.DS_Store

# Binario suelto y fotos de referencia que se colaron al repo. Ya salieron del
# indice con `git rm --cached`, siguen en el disco de quien los tenia y quedan
# ignorados; solo sobreviven en el historial antiguo.
/main
/IMG_*.png

# Claves privadas. La .p8 de App Store Connect se descarga una sola vez y
# vale para firmar y subir builds en nombre del equipo: si entra al repo,
# rotarla es el unico arreglo. Vive en GitHub Secrets, nunca aqui.
*.p8
*.p12
*.mobileprovision
AuthKey_*

# Herramientas del entorno de agentes dentro de privacy-site: no son parte del sitio.
privacy-site/.agents/
privacy-site/.claude/
privacy-site/agent/
privacy-site/skills-lock.json

# Configuracion local del editor (VS Code / SweetPad): apunta al workspace de
# esta maquina, no es parte del proyecto.
.vscode/
