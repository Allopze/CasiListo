/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# El nombre del CSS lleva el hash de su contenido (build.mjs): puede cachearse un año.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

# Íconos e imágenes no llevan hash: un día de caché basta para que un cambio llegue.
/assets/icons/*
  Cache-Control: public, max-age=86400
/assets/images/*
  Cache-Control: public, max-age=86400
